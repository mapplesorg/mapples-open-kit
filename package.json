{
  "name": "mapples-open-kit",
  "version": "0.0.0",
  "description": "Mapples kit",
  "repository": "https://github.com/mapplesorg/mapples-kit.git",
  "author": "Oleksandr Soloviov <oleksolv@gmail.com>",
  "license": "UNLICENSED",
  "private": true,
  "workspaces": [
    "packages/@mapples/*"
  ],
  "packageManager": "yarn@4.9.1",
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json}\"",
    "prepare": "husky",
    "docs": "typedoc --options typedoc.config.mjs --tsconfig tsconfig.base.json"
  },
  "dependencies": {
    "@react-native-picker/picker": "^2.11.0",
    "aws-amplify": "^6.15.0",
    "axios": "^1.12.1",
    "date-fns": "^4.1.0",
    "expo": "~54.0.9",
    "expo-image": "~3.0.8",
    "expo-router": "~6.0.7",
    "expo-video": "~3.0.11",
    "i18next": "^25.1.1",
    "lodash": "^4.17.21",
    "react": "19.1.0",
    "react-i18next": "^15.5.1",
    "react-native": "0.81.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-json-tree": "^1.5.0",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "reanimated-color-picker": "^4.0.1",
    "rxjs": "^7.8.2",
    "toastify-react-native": "^7.2.3",
    "uuid": "^11.1.0",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@types/lodash": "^4.17.16",
    "@types/react": "~19.1.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "turbo": "^2.3.3",
    "typedoc": "^0.28.13",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "~5.9.2"
  },
  "resolutions": {
    "uuid": "^11.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
