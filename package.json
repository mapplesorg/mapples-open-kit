{
  "name": "mapples-open-kit",
  "version": "0.0.0",
  "description": "Source mirror of the open-source @mapples/* React Native packages behind Mapples",
  "repository": {
    "type": "git",
    "url": "https://github.com/mapplesorg/mapples-open-kit.git"
  },
  "homepage": "https://mapples.org",
  "author": {
    "name": "Oleksandr Soloviov",
    "url": "https://mapples.org/people/olek_soloviov"
  },
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/@mapples/*"
  ],
  "packageManager": "yarn@4.9.1",
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json}\"",
    "prepare": "husky",
    "docs": "typedoc --options typedoc.config.mjs --tsconfig tsconfig.base.json"
  },
  "dependencies": {
    "@react-native-picker/picker": "2.11.4",
    "@react-native-vector-icons/ant-design": "^13.1.3",
    "@react-native-vector-icons/entypo": "^13.1.3",
    "@react-native-vector-icons/evil-icons": "^13.1.3",
    "@react-native-vector-icons/feather": "^13.1.3",
    "@react-native-vector-icons/fontawesome": "^13.1.3",
    "@react-native-vector-icons/fontawesome5": "^13.1.3",
    "@react-native-vector-icons/fontawesome6": "^13.1.3",
    "@react-native-vector-icons/fontisto": "^13.1.3",
    "@react-native-vector-icons/foundation": "^13.1.3",
    "@react-native-vector-icons/ionicons": "^13.1.3",
    "@react-native-vector-icons/lucide": "^13.1.3",
    "@react-native-vector-icons/material-design-icons": "^13.1.3",
    "@react-native-vector-icons/material-icons": "^13.1.3",
    "@react-native-vector-icons/octicons": "^21.1.3",
    "@react-native-vector-icons/simple-line-icons": "^13.1.3",
    "@react-native-vector-icons/zocial": "^13.1.3",
    "aws-amplify": "^6.15.0",
    "axios": "^1.18.0",
    "date-fns": "^4.1.0",
    "expo": "~56.0.12",
    "expo-image": "~56.0.11",
    "expo-router": "~56.2.11",
    "expo-video": "~56.1.4",
    "i18next": "^25.1.1",
    "jsbarcode": "^3.12.1",
    "lodash": "^4.18.1",
    "react": "19.2.3",
    "react-i18next": "^15.5.1",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-json-tree": "^1.5.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "reanimated-color-picker": "^4.0.1",
    "rxjs": "^7.8.2",
    "toastify-react-native": "^7.2.3",
    "uuid": "^11.1.0",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/lodash": "^4.17.24",
    "@types/react": "~19.2.14",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~56.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.5",
    "lint-staged": "^16.1.6",
    "prettier": "^3.8.2",
    "turbo": "^2.3.3",
    "typedoc": "^0.28.13",
    "typedoc-plugin-markdown": "^4.9.0",
    "typescript": "~6.0.3"
  },
  "resolutions": {
    "uuid": "^11.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
