{
  "name": "@mapples/codegen",
  "version": "2.0.4",
  "description": "Pure RenderDom -> TSX file generation for Mapples pages and components: imports, hoisted styles, linked component instances. No I/O, no formatting.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "author": {
    "name": "Oleksandr Soloviov",
    "url": "https://mapples.org/people/olek_soloviov"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mapplesorg/mapples-open-kit.git",
    "directory": "packages/@mapples/codegen"
  },
  "dependencies": {
    "@mapples/sid-ast": "workspace:*"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=18.18"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ]
}
