    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "author": {
    "name": "Oleksandr Soloviov",
    "url": "https://mapples.org/people/olek_soloviov"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mapplesorg/mapples-open-kit.git",
    "directory": "packages/@mapples/fonts"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "~6.0.3"
  },
  "files": [
    "dist",
    "assets",
    "README.md",
    "package.json"
  ]
}
