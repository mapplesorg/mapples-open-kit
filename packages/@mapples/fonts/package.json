{
  "name": "@mapples/fonts",
  "version": "2.0.2",
  "description": "The bundled font library every Mapples project can use: 21 open-licensed families, registered per weight.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -b tsconfig.build.json && node ./scripts/copy-assets.mjs",
