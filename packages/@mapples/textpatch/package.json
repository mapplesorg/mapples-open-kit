  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "author": {
    "name": "Oleksandr Soloviov",
    "url": "https://mapples.org/people/olek_soloviov"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mapplesorg/mapples-open-kit.git",
    "directory": "packages/@mapples/textpatch"
  },
  "dependencies": {
    "@noble/hashes": "^1.5.0",
    "diff": "^9.0.0"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=18.18"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ]
