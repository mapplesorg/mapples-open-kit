{
  "name": "@mapples/api-import",
  "version": "1.5.0",
  "description": "Turns cURL commands, OpenAPI 3 / Swagger 2 documents and Postman collections into Mapples API requests, and merges them into a project API document. Pure: no I/O.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "author": {
    "name": "Oleksandr Soloviov",
    "url": "https://mapples.org/people/olek_soloviov"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mapplesorg/mapples-open-kit.git",
    "directory": "packages/@mapples/api-import"
  },
  "dependencies": {
    "@mapples/types": "workspace:*",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=18.18"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ]
}
